    "astro-embed": "^0.14.0",
    "dotenv": "^18.0.6",
    "papaparse": "^5.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/papaparse": "^5.3.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
