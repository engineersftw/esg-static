{
  "name": "@esg/static-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:functions": "astro build && wrangler pages dev ./dist",
    "astro": "astro",
    "deploy": "wrangler pages deploy ./dist --project-name esg-static",
    "deploy:production": "wrangler pages deploy ./dist --project-name esg-static --branch main",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "astro-embed": "^0.14.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
