---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import GoogleTagManager from "./GoogleTagManager.astro";
---

<GoogleTagManager part="body" />
<header>
  <nav>
    <h2>
      <a href="/" class="brand">
        <img src="/engineerssg-logo.png" alt="" width="32" height="32" />
        <span class="brand-text">{SITE_TITLE}</span>
      </a>
    </h2>
    <div class="internal-links" id="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/videos">Videos</HeaderLink>
      <HeaderLink href="/conferences">Conferences</HeaderLink>
      <HeaderLink href="/organizations">Organizations</HeaderLink>
      <HeaderLink href="/presenters">Presenters</HeaderLink>
      <HeaderLink href="/categories">Categories</HeaderLink>
      <HeaderLink href="/events">Events</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    <div class="actions">
      <a href="/search" class="search-link" aria-label="Search videos" title="Search videos">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          width="28"
          height="28"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5 21 21"></path>
        </svg>
      </a>
      <button type="button" class="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <div class="social-links">
        <a href="https://x.com/engineersftw" target="_blank">
          <span class="sr-only">Follow Engineers.SG on Twitter</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
            ><path
              fill="currentColor"
              d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
            ></path></svg
          >
        </a>
        <a href="https://github.com/engineersftw" target="_blank">
          <span class="sr-only">Go to Engineers.SG's GitHub repo</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
        </a>
      </div>
      <button
        type="button"
        class="menu-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="internal-links"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>
<script>
  // The theme itself is set in BaseHead's inline script; this saves the visitor's choice. The label
  // names what the button does next, so screen readers can tell which mode is on.
  const themeButton = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const labelTheme = () => {
    const label = `Switch to ${document.documentElement.dataset.theme === "dark" ? "light" : "dark"} mode`;
    themeButton?.setAttribute("aria-label", label);
    themeButton?.setAttribute("title", label);
  };
  labelTheme();
  themeButton?.addEventListener("click", () => {
    const root = document.documentElement;
    const theme = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = theme;
    labelTheme();
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // Private mode or blocked storage: the choice lasts for this page only.
    }
  });
  document.querySelectorAll<HTMLButtonElement>(".menu-toggle").forEach((button) => {
    const nav = button.closest("nav");
    button.addEventListener("click", () => {
      const open = nav?.classList.toggle("open") ?? false;
      button.setAttribute("aria-expanded", String(open));
    });
  });
</script>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--bg);
    border-top: 4px solid var(--orange);
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5em;
    white-space: nowrap;
  }
  nav a.brand {
    padding: 0.5em;
    gap: 0.65em;
    font-size: 1.35em;
  }
  .brand img {
    display: block;
    flex: none;
    width: 48px;
    height: 48px;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.4em;
    white-space: nowrap;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--orange);
  }
  .actions,
  .social-links,
  .social-links a {
    display: flex;
    align-items: center;
  }
  nav a.search-link {
    display: flex;
    padding: 0.5em;
    border-bottom: 0;
    color: rgb(var(--black));
  }
  nav a.search-link:hover {
    color: var(--accent);
  }
  .theme-toggle {
    display: flex;
    padding: 0.5em;
    color: rgb(var(--black));
    background: none;
    border: 0;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
  }
  .sun,
  :global(html[data-theme='dark']) .moon {
    display: none;
  }
  :global(html[data-theme='dark']) .sun {
    display: block;
  }
  .menu-toggle {
    display: none;
    padding: 0.5em;
    color: rgb(var(--black));
    background: none;
    border: 0;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .social-links,
    .brand-text {
      display: none;
    }
    nav {
      flex-wrap: wrap;
    }
    nav a.brand {
      padding: 0.5em;
      font-size: 1em;
    }
    .brand img {
      width: 32px;
      height: 32px;
    }
    .menu-toggle {
      display: block;
    }
    .actions {
      order: 2;
    }
    .internal-links {
      display: none;
      flex-direction: column;
      order: 3;
      width: 100%;
      padding-bottom: 0.5em;
    }
    nav.open .internal-links {
      display: flex;
    }
    nav .internal-links :global(a) {
      padding: 0.75em 0.5em;
      border-bottom: 0;
      border-left: 4px solid transparent;
    }
    nav .internal-links :global(a.active) {
      border-bottom-color: transparent;
      border-left-color: var(--accent);
    }
  }
</style>
