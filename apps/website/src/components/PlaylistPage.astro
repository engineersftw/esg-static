---
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Pagination from './Pagination.astro';
import FormattedDate from './FormattedDate.astro';
import VideoCard from './VideoCard.astro';
import LinkedText from './LinkedText.astro';

interface Props {
  page: Page<CollectionEntry<'video'>>;
  playlist: CollectionEntry<'playlist'>;
  parent?: CollectionEntry<'playlist'>;
  subPlaylists: CollectionEntry<'playlist'>[];
  /** URL prefix for this page and its parent/sub-playlist links: "/conference" or "/playlist". */
  basePath: string;
}

const { page, playlist: conference, parent, subPlaylists, basePath } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={conference.data.playlistTitle}
      description={conference.body || `${page.total.toLocaleString('en')} ${page.total === 1 ? 'video' : 'videos'} from ${conference.data.playlistTitle.trim()}, recorded by Engineers.SG.`}
      image={conference.data.image}
      pageNumber={page.currentPage}
    />
    <style>
      main {
        width: 960px;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .playlistDescr {
        white-space: pre-line;
        overflow-wrap: anywhere;
      }
      .meta {
        color: rgb(var(--gray));
      }
      @media (max-width: 720px) {
        h1 {
          font-size: 1.953em;
          line-height: 1.15;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        {
          conference.data.image && (
            <div class="hero-image">
              <img
                src={conference.data.image}
                alt={conference.data.playlistTitle}
              />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <h1>{conference.data.playlistTitle}</h1>
            <hr />
          </div>
          {
            parent && (
              <p class="meta">
                Part of{' '}
                <a href={`${basePath}/${parent.data.slug}`}>
                  {parent.data.playlistTitle}
                </a>
              </p>
            )
          }
          {
            (conference.data.publishDate || conference.data.website) && (
              <p class="meta">
                {conference.data.publishDate && (
                  <FormattedDate date={conference.data.publishDate} />
                )}
                {conference.data.publishDate && conference.data.website && ' · '}
                {conference.data.website && (
                  <a href={conference.data.website} target="_blank" rel="noopener noreferrer">
                    {conference.data.website}
                  </a>
                )}
              </p>
            )
          }
          <p class="playlistDescr"><LinkedText text={conference.body} /></p>
          {
            subPlaylists.length > 0 && (
              <>
                <h4>Tracks</h4>
                <ul class="tracks">
                  {subPlaylists.map((sub) => (
                    <li>
                      <a href={`${basePath}/${sub.data.slug}`}>{sub.data.playlistTitle}</a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>

        <h2>Videos ({page.total})</h2>
        <section>
          <ul class="video-grid">
            {page.data.map((video, i) => <VideoCard video={video} featured={i === 0} />)}
          </ul>
        </section>
        <Pagination page={page} />
      </article>
    </main>
    <Footer />
  </body>
</html>
