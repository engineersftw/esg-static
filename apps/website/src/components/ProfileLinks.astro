---
import LinkIcon from './LinkIcon.astro';
import { PROFILE_LINK_NAMES, type ProfileLinkType } from '../consts';
import { profileLinkLabel } from '../helpers/url_helpers';

// A presenter's or organization's links (the `links` frontmatter), in their stored order, each
// with its icon. Nothing renders when there are none.
interface Props {
  links: { type: ProfileLinkType; url: string }[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <p class="links">
      {links.map(({ type, url }) => (
        <a href={url} target="_blank" rel="noopener noreferrer" title={PROFILE_LINK_NAMES[type]}>
          <LinkIcon kind={type} />
          <span class="sr-only">{PROFILE_LINK_NAMES[type]}: </span>
          {profileLinkLabel(type, url)}
        </a>
      ))}
    </p>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.5em;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    overflow-wrap: anywhere;
  }
  .links :global(svg) {
    flex: none;
  }
  @media (max-width: 720px) {
    .links {
      flex-direction: column;
      gap: 0.25em;
    }
    .links a {
      line-height: 1.5;
    }
  }
</style>
