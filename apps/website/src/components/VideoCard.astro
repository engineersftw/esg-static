---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getVideoByline } from '../helpers/collections';

// One video in a list: a 16:9 thumbnail, the title, and the date with the presenters' and
// organizations' names. Put it in `<ul class="video-grid">`. The styles are global (global.css),
// because the search page builds the same card in the browser. `featured` shows it full width with
// a larger title, as the first video of a list is.
interface Props {
  video: CollectionEntry<'video'>;
  featured?: boolean;
  /** A name to leave out of the byline: the organization or presenter whose page this is. */
  without?: string;
}

const { video, featured = false, without } = Astro.props;
const { thumbnailDefault, thumbnailMedium, thumbnailHigh } = video.data;
// The high-quality thumbnail has black bars above and below, which the 16:9 crop removes, and it
// has more pixels than the medium one, which a full-width card needs.
const thumbnail = featured
  ? (thumbnailHigh ?? thumbnailMedium ?? thumbnailDefault)
  : (thumbnailMedium ?? thumbnailHigh ?? thumbnailDefault);
const byline = await getVideoByline(video, without);
---

<li class:list={['video-card', { featured }]}>
  <a href={`/video/${video.data.slug}`}>
    {
      thumbnail ? (
        <img
          class="video-card-image"
          src={thumbnail}
          alt=""
          width={featured ? 480 : 320}
          height={featured ? 270 : 180}
          loading={featured ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="video-card-image"></div>
      )
    }
    <h4 class="video-card-title">{video.data.videoTitle}</h4>
    <p class="video-card-meta">
      <FormattedDate date={video.data.publishedAt} />{byline && ` · ${byline}`}
    </p>
  </a>
</li>
