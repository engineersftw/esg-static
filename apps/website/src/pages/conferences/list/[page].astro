---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Pagination from "../../../components/Pagination.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../consts";
import FormattedDate from "../../../components/FormattedDate.astro";
import { getConferences } from "../../../helpers/collections";

export async function getStaticPaths({ paginate }) {
  const conferences = await getConferences();
  return paginate(conferences, { pageSize: 50 });
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 960px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(30% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
      .playlistImage {
        width: auto;
        min-height: 250px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        border-radius: 12px;
        margin-bottom: 0.5rem;
        transition: 0.2s ease;
      }

      .playlistImage:hover {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Conferences</h1>
      <section>
        <ul>
          {
            page.data.map((conference) => (
              <li>
                <a href={`/conference/${conference.data.slug}`}>
                  <div
                    class="playlistImage"
                    style={`background-image: url(${conference.data.image});`}
                  />
                  <h4 class="title">{conference.data.playlistTitle}</h4>
                  {conference.data.publishDate && (
                    <p class="date">
                      <FormattedDate date={conference.data.publishDate} />
                    </p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <Pagination page={page} />
    </main>
    <Footer />
  </body>
</html>
