---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTopicGroups } from '../helpers/collections';

const groups = await getTopicGroups();
const total = new Set(groups.flatMap((g) => g.topics.map((t) => t.slug))).size;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Categories"
      description={`Browse the talks on Engineers.SG by topic: ${total} topics across ${groups.length} groups, from programming languages and cloud to hardware and design.`}
    />
    <style>
      main {
        width: 1100px;
      }
      .groups {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        align-items: start;
        margin-top: 1.5rem;
      }
      .group {
        background: rgb(var(--gray-light));
        border-radius: 12px;
        padding: 1rem 1rem 0.75rem;
      }
      .group h2 {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: baseline;
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
        line-height: 1.3;
      }
      .count {
        color: rgb(var(--gray));
        font-size: 0.8rem;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
      }
      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      li a {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.3rem 0;
        color: rgb(var(--gray-dark));
        text-decoration: none;
        font-size: 0.95rem;
      }
      li a:hover {
        color: var(--orange);
      }
      @media (max-width: 960px) {
        .groups {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 720px) {
        .groups {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Categories</h1>
      <div class="groups">
        {
          groups.map((group) => (
            <section class="group">
              <h2>
                {group.title}
                <span class="count">{group.count.toLocaleString('en')}</span>
              </h2>
              <ul>
                {group.topics.map((topic) => (
                  <li>
                    <a href={`/category/${topic.slug}`}>
                      <span>{topic.title}</span>
                      <span class="count">{topic.count.toLocaleString('en')}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
