---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Pagination from '../../../components/Pagination.astro';
import EntityImage from '../../../components/EntityImage.astro';
import ProfileLinks from '../../../components/ProfileLinks.astro';
import LinkedText from '../../../components/LinkedText.astro';
import VideoCard from '../../../components/VideoCard.astro';
import { getActivePresenters, getPresenterVideos } from '../../../helpers/collections';

export const getStaticPaths = (async ({ paginate }) => {
  const presenters = await getActivePresenters();

  return Promise.all(presenters.map(async (presenter) => {
    const videos = await getPresenterVideos(presenter.id);
    return paginate(videos, {
      params: { slug: presenter.data.slug },
      pageSize: 25,
      props: { presenter },
    });
  })).then((pages) => pages.flat());
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, presenter } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={presenter.data.presenterName}
      description={presenter.body || presenter.data.presenterByline || `${page.total.toLocaleString('en')} ${page.total === 1 ? 'talk' : 'talks'} by ${presenter.data.presenterName.trim()}, recorded by Engineers.SG.`}
      image={presenter.data.imageUrl}
      card="summary"
      pageNumber={page.currentPage}
      type="profile"
    />
    <style>
      main {
        width: 960px;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .presenterDescr {
        white-space: pre-line;
        overflow-wrap: anywhere;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          <EntityImage
            kind="presenter"
            src={presenter.data.imageUrl}
            alt={presenter.data.presenterName}
          />
        </div>
        <div class="prose">
          <div class="title">
            <h1>{presenter.data.presenterName}</h1>
            <hr />
          </div>

          {
            presenter.data.presenterByline && (
              <h4>{presenter.data.presenterByline}</h4>
            )
          }
          <ProfileLinks links={presenter.data.links} />
          <p class="presenterDescr"><LinkedText text={presenter.body} /></p>
        </div>

        <h2>Videos ({page.total})</h2>
        <section>
          <ul class="video-grid">
            {
              page.data.map((video, i) => (
                <VideoCard video={video} featured={i === 0} without={presenter.data.presenterName} />
              ))
            }
          </ul>
        </section>
        <Pagination page={page} />
      </article>
    </main>
    <Footer />
  </body>
</html>
