---
import { getActivePresenters } from "../../../helpers/collections";

export async function getStaticPaths() {
  const presenters = await getActivePresenters();
  return presenters.map((presenter) => ({
    params: { slug: presenter.data.slug },
    props: presenter,
  }));
}

const { slug } = Astro.params;

return Astro.rewrite(`/presenter/${slug}/1`);
---
