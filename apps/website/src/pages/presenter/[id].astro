---
import type { CollectionEntry } from "astro:content";
import { getActivePresenters } from "../../helpers/collections";

export async function getStaticPaths() {
  const presenters = await getActivePresenters();
  return presenters.map((presenter) => ({
    params: { id: presenter.id },
    props: presenter,
  }));
}

const presenter = Astro.props;

return Astro.redirect(`/presenter/${presenter.data.slug}`, 301);
---
