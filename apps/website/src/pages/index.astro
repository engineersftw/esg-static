---

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoCard from '../components/VideoCard.astro';
import { getListedVideos } from '../helpers/collections';

const videos = await getListedVideos();

const content = videos.slice(0, 9);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <style>
      main {
        width: 960px;
      }
      .more {
        margin: 2rem 0 1rem;
        text-align: center;
      }
      .button {
        display: inline-block;
        padding: 0.9em 2.2em;
        color: white;
        font-size: 1.15em;
        font-weight: 700;
        text-decoration: none;
        background: var(--accent);
        border-radius: 999px;
        box-shadow: 0 4px 14px rgba(var(--black), 20%);
        transition: 0.2s ease;
      }
      .button:hover,
      .button:focus-visible {
        background: var(--accent-dark);
        transform: translateY(-2px);
      }
      @media (max-width: 720px) {
        .button {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Welcome to Engineers.SG</h1>
      <section>
        <ul class="video-grid">
          {content.map((video, i) => <VideoCard video={video} featured={i === 0} />)}
        </ul>
        <div class="more">
          <a href="/videos" class="button">More videos <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
