---
// Cloudflare Pages serves this with a 404 status for any missing path. Without it, Pages falls
// back to the home page with a 200, so unknown and inactive URLs would look like they exist.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Page not found | ${SITE_TITLE}`} description="This page could not be found." />
    <style>
      main {
        text-align: center;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        padding: 0;
        list-style: none;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Page not found</h1>
      <p>This page doesn't exist, or the video has been taken down.</p>
      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="/videos">Videos</a></li>
        <li><a href="/conferences">Conferences</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/presenters">Presenters</a></li>
      </ul>
    </main>
    <Footer />
  </body>
</html>
