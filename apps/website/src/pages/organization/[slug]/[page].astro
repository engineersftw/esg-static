---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getEntries } from 'astro:content';

import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Pagination from '../../../components/Pagination.astro';
import EntityImage from '../../../components/EntityImage.astro';
import ProfileLinks from '../../../components/ProfileLinks.astro';
import LinkedText from '../../../components/LinkedText.astro';
import VideoCard from '../../../components/VideoCard.astro';
import { getActiveOrganizations, listed } from '../../../helpers/collections';

export const getStaticPaths = (async ({ paginate }) => {
  const organizations = await getActiveOrganizations();

  return Promise.all(organizations.map(async (organization) => {
    const videos = listed(await getEntries(organization.data.videos));
    return paginate(videos, {
      params: { slug: organization.data.slug },
      pageSize: 25,
      props: { organization },
    });
  })).then((pages) => pages.flat());
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, organization } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={organization.data.orgTitle}
      description={organization.body || `${page.total.toLocaleString('en')} ${page.total === 1 ? 'video' : 'videos'} from ${organization.data.orgTitle.trim()} meetups and events, recorded by Engineers.SG.`}
      image={organization.data.logoImage}
      card="summary"
      pageNumber={page.currentPage}
    />
    <style>
      main {
        width: 960px;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .contact {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .orgDescr {
        white-space: pre-line;
        overflow-wrap: anywhere;
      }
      @media (max-width: 720px) {
        h1 {
          font-size: 1.953em;
          line-height: 1.15;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          <EntityImage
            kind="organization"
            src={organization.data.logoImage}
            alt={organization.data.orgTitle}
          />
        </div>
        <div class="prose">
          <div class="title">
            <h1>{organization.data.orgTitle}</h1>
            <hr />
          </div>
          {
            organization.data.contactPerson && (
              <p class="contact">Contact: {organization.data.contactPerson}</p>
            )
          }
          <ProfileLinks links={organization.data.links} />
          <p class="orgDescr"><LinkedText text={organization.body} /></p>
        </div>

        <h2>Videos ({page.total})</h2>
        <section>
          <ul class="video-grid">
            {
              page.data.map((video, i) => (
                <VideoCard video={video} featured={i === 0} without={organization.data.orgTitle} />
              ))
            }
          </ul>
        </section>
        <Pagination page={page} />
      </article>
    </main>
    <Footer />
  </body>
</html>
