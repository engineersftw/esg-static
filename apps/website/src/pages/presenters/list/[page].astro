---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getActivePresenters } from "../../../helpers/collections";

import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Pagination from "../../../components/Pagination.astro";
import EntityImage from "../../../components/EntityImage.astro";
import NameFilter from "../../../components/NameFilter.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const presenters = (await getActivePresenters()).sort((a, b) =>
    a.data.presenterName.trim().localeCompare(b.data.presenterName.trim())
  );
  return paginate(presenters, { pageSize: 48 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title="Presenters"
      description={`${page.total.toLocaleString('en')} speakers at tech meetups and conferences in Singapore, recorded by Engineers.SG.`}
      pageNumber={page.currentPage}
    />
    <style>
      main {
        width: 960px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(30% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
      .orgImage {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
        border-radius: 12px;
        margin-bottom: 0.5rem;
        transition: 0.2s ease;
      }

      .orgImage:hover {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: calc(50% - 0.25em);
          text-align: center;
        }
        .title {
          font-size: 1em;
          line-height: 1.2;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Presenters</h1>
      <NameFilter kind="presenter" label="presenters" source="/presenters.json" />
      <div data-name-filter-page>
      <section>
        <ul>
          {
            page.data.map((presenter) => (
              <li>
                <a href={`/presenter/${presenter.data.slug}`}>
                  <EntityImage
                    class="orgImage"
                    kind="presenter"
                    src={presenter.data.imageUrl}
                    alt=""
                    loading="lazy"
                  />
                  <h4 class="title">{presenter.data.presenterName}</h4>
                </a>
                {presenter.data.presenterByline && (
                  <p>{presenter.data.presenterByline}</p>
                )}
              </li>
            ))
          }
        </ul>
      </section>
      <Pagination page={page} />
      </div>
      <ul data-name-filter-results hidden></ul>
      <template data-name-filter-item>
        <li>
          <a>
            <img class="orgImage" alt="" loading="lazy" />
            <h4 class="title"></h4>
          </a>
          <p data-byline></p>
        </li>
      </template>
    </main>
    <Footer />
  </body>
</html>
