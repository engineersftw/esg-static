---
// Old Rails shortcut /:id (numeric video ID), e.g. /601.
import type { CollectionEntry } from "astro:content";
import { getActiveVideos } from "../helpers/collections";

export async function getStaticPaths() {
  const videos = await getActiveVideos();
  return videos.map((video) => ({
    params: { id: video.id },
    props: video,
  }));
}
type Props = CollectionEntry<"video">;

const video = Astro.props;

return Astro.redirect(`/video/${video.data.slug}`, 301);
---
