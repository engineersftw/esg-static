---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Pagination from '../../components/Pagination.astro';
import VideoCard from '../../components/VideoCard.astro';
import { getListedVideos } from '../../helpers/collections';

// The newest video is shown large above the grid on the first page only, so it is left out of the
// paginated list; every page then has 50 videos in full rows of 2.
export const getStaticPaths = (async ({ paginate }) => {
  const [featured, ...videos] = await getListedVideos();
  return paginate(videos, { pageSize: 50, props: { featured, total: videos.length + 1 } });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, featured, total } = Astro.props;
const shown = page.currentPage === 1 ? [featured, ...page.data] : page.data;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Videos"
      description={`${total.toLocaleString('en')} videos of tech meetups and conferences in Singapore, recorded by Engineers.SG.`}
      pageNumber={page.currentPage}
    />
    <style>
      main {
        width: 960px;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Videos</h1>
      <section>
        <ul class="video-grid">
          {shown.map((video) => <VideoCard video={video} featured={video === featured} />)}
        </ul>
      </section>
      <Pagination page={page} />
    </main>
    <Footer />
  </body>
</html>
