---
// Video keyword search. The page is static; its script calls the Pages Function at /api/search
// (functions/api/search.ts) as the visitor types, and keeps the query in the address (?q=) so a
// search can be shared or reloaded. `pnpm preview` doesn't run Functions, so test it with
// `wrangler pages dev ./dist`.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Search videos"
      description="Search the talks recorded by Engineers.SG by title, speaker, group, conference or description."
    />
    <style is:global>
      .search-page main {
        width: 960px;
      }
      .search-page form {
        display: flex;
        gap: 0.5em;
        margin-bottom: 1em;
      }
      .search-page input[type='search'] {
        flex: 1;
        box-sizing: border-box;
        height: 3em;
        min-width: 0;
        padding: 0 0.8em;
        font: inherit;
        border: 1px solid rgb(var(--gray-light));
        border-radius: 8px;
        background: white;
      }
      .search-page input[type='search']:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      .search-page form button {
        display: grid;
        flex: none;
        place-items: center;
        width: 3em;
        height: 3em;
        padding: 0;
        font: inherit;
        color: white;
        background: var(--accent);
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }
      .search-page .more {
        padding: 0.6em 1.4em;
        font: inherit;
        font-weight: 700;
        color: white;
        background: var(--accent);
        border: 0;
        border-radius: 999px;
        cursor: pointer;
      }
      .search-page form button:hover,
      .search-page .more:hover {
        background: var(--accent-dark);
      }
      .search-page .status {
        min-height: 1.7em;
        color: rgb(var(--gray));
      }
      .search-page .results {
        margin-top: 1em;
      }
      .search-page .more {
        display: block;
        margin: 2em auto 1em;
      }
    </style>
  </head>
  <body class="search-page">
    <Header />
    <main>
      <h1>Search videos</h1>
      <form id="search-form" action="/search" method="get" role="search">
        <label for="search-input" class="sr-only">Search videos</label>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="Titles, speakers, groups…"
          autocomplete="off"
          maxlength="100"
          autofocus
        />
        <button type="submit" aria-label="Search" title="Search">
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
          >
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="M15.5 15.5 21 21"></path>
          </svg>
        </button>
      </form>
      <p id="search-status" class="status" aria-live="polite"></p>
      <noscript><p>Search needs JavaScript. You can still <a href="/videos">browse every video</a>.</p></noscript>
      <ul id="search-results" class="video-grid results"></ul>
      <button id="search-more" class="more" type="button" hidden>More results</button>
    </main>
    <Footer />
  </body>
</html>

<script>
  import type { SearchResponse, SearchResult } from '../helpers/search';

  const form = document.querySelector<HTMLFormElement>('#search-form')!;
  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const status = document.querySelector<HTMLParagraphElement>('#search-status')!;
  const list = document.querySelector<HTMLUListElement>('#search-results')!;
  const more = document.querySelector<HTMLButtonElement>('#search-more')!;

  const MIN_LENGTH = 2;
  const DEBOUNCE_MS = 300;
  let latest = 0; // Only the newest request's response is shown.
  let shown = { query: '', page: 0, total: 0 };
  let timer: ReturnType<typeof setTimeout> | undefined;

  const formatDate = (iso: string) =>
    new Date(iso).toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });

  // The same card as VideoCard.astro, with the same classes (styled in global.css). Built with DOM
  // APIs and textContent, so titles and names are never parsed as HTML.
  function item(result: SearchResult): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'video-card';
    const a = document.createElement('a');
    a.href = `/video/${result.slug}`;
    let image: HTMLElement;
    if (result.thumbnail) {
      const img = document.createElement('img');
      img.width = 320;
      img.height = 180;
      img.loading = 'lazy';
      img.alt = '';
      img.src = result.thumbnail;
      image = img;
    } else {
      image = document.createElement('div');
    }
    image.className = 'video-card-image';
    const title = document.createElement('h4');
    title.className = 'video-card-title';
    title.textContent = result.title;
    const meta = document.createElement('p');
    meta.className = 'video-card-meta';
    meta.textContent = [formatDate(result.date), [...result.presenters, ...result.organizations].join(', ')]
      .filter(Boolean)
      .join(' · ');
    a.append(image, title, meta);
    li.append(a);
    return li;
  }

  function setAddress(query: string) {
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  async function search(query: string, page = 1) {
    const request = ++latest;
    if (page === 1) setAddress(query);
    if (query.length < MIN_LENGTH) {
      list.replaceChildren();
      more.hidden = true;
      shown = { query: '', page: 0, total: 0 };
      status.textContent = query ? `Type at least ${MIN_LENGTH} characters.` : '';
      return;
    }

    if (page === 1) status.textContent = 'Searching…';
    else more.textContent = 'Loading…';
    try {
      const response = await fetch(`/api/search?${new URLSearchParams({ q: query, page: String(page) })}`);
      if (!response.ok || !response.headers.get('content-type')?.includes('json')) throw new Error(`HTTP ${response.status}`);
      const data: SearchResponse = await response.json();
      if (request !== latest) return;

      if (page === 1) list.replaceChildren();
      list.append(...data.results.map(item));
      shown = { query, page: data.page, total: data.total };
      const count = `${data.total.toLocaleString('en')} ${data.total === 1 ? 'video matches' : 'videos match'}`;
      status.textContent = data.total ? `${count} “${data.query}”.` : `No videos match “${data.query}”.`;
      more.hidden = list.children.length >= data.total;
    } catch {
      if (request !== latest) return;
      status.textContent = "Search isn't available right now. Please try again later.";
      more.hidden = true;
    } finally {
      more.textContent = 'More results';
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => search(input.value.trim()), DEBOUNCE_MS);
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    search(input.value.trim());
  });
  more.addEventListener('click', () => search(shown.query, shown.page + 1));

  const initial = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  if (initial) {
    input.value = initial;
    search(initial);
  }
</script>
