---
// Old Rails URLs, /video/<name>--<id>, where <name> is the parameterized videoTitle. Only the
// current title is known at build time, so a link made before a rename won't match.
import { getActiveVideos } from "../../helpers/collections";
import { parameterize } from "../../helpers/url_helpers";

export async function getStaticPaths() {
  const entries = await getActiveVideos();
  return entries
    .map((entry) => ({
      params: { name: parameterize(entry.data.videoTitle), id: entry.id },
      props: { slug: entry.data.slug },
    }))
    .filter(({ params }) => params.name);
}

return Astro.redirect(`/video/${Astro.props.slug}`, 301);
---
