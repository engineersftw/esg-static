---
import { type CollectionEntry, getEntries } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import EntityImage from '../../components/EntityImage.astro';
import LinkedText from '../../components/LinkedText.astro';
import { YouTube } from 'astro-embed';
import { getActiveVideos, listedOrganizations, listedPresenters } from '../../helpers/collections';
import { formatDuration } from '../../helpers/duration';
import { videoJsonLd } from '../../helpers/jsonLd';

export async function getStaticPaths() {
  const videos = await getActiveVideos();
  return videos.map((video) => ({
    params: { slug: video.data.slug },
    props: video,
  }));
}
type Props = CollectionEntry<'video'>;

const video = Astro.props;
const organizations = listedOrganizations(await getEntries(video.data.organizations));
const presenters = listedPresenters(await getEntries(video.data.presenters));
const duration = formatDuration(video.data.duration);
---

<html lang="en">
  <head>
    <BaseHead
      title={video.data.videoTitle}
      description={video.body || (presenters.length > 0
        ? `A talk by ${presenters.map((presenter) => presenter.data.presenterName.trim()).join(', ')}, recorded by Engineers.SG.`
        : undefined)}
      image={video.data.thumbnailHigh ?? video.data.thumbnailMedium ?? video.data.thumbnailDefault}
      type="video.other"
      jsonLd={videoJsonLd({
        site: Astro.site!,
        slug: video.data.slug,
        title: video.data.videoTitle,
        description: video.body,
        publishedAt: video.data.publishedAt,
        duration: video.data.duration,
        thumbnails: [video.data.thumbnailHigh, video.data.thumbnailMedium, video.data.thumbnailDefault],
        videoId: video.data.videoId,
        videoSite: video.data.videoSite,
        presenters: presenters.map((p) => ({ name: p.data.presenterName, slug: p.data.slug })),
        organizations: organizations.map((o) => ({ name: o.data.orgTitle, slug: o.data.slug })),
      })}
    />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image lite-youtube {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        text-align: center;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }

      .videoDescr {
        white-space: pre-line;
        overflow-wrap: anywhere;
      }

      @media (max-width: 720px) {
        .title h1 {
          font-size: 1.953em;
          line-height: 1.15;
        }
      }

      .people {
        list-style: none;
        padding: 0;
      }
      h5 a {
        display: flex;
        align-items: center;
        gap: 0.5em;
        text-decoration: none;
        color: rgb(var(--gray-dark));
      }
      h5 a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          <YouTube id={video.data.videoId} posterQuality="max" />
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={video.data.publishedAt} />
              {duration && (
                <>
                  {' · '}
                  <time datetime={video.data.duration} title="Video length">{duration}</time>
                </>
              )}
            </div>
            <h1>{video.data.videoTitle}</h1>
            <hr />
          </div>
          <p class="videoDescr"><LinkedText text={video.body} /></p>

          {organizations.length > 0 && <h4>Organizations</h4>}
          <ul class="people">
            {
              organizations.map((org) => (
                <li>
                  <h5>
                    <a href={`/organization/${org.data.slug}`}>
                      <EntityImage
                        kind="organization"
                        src={org.data.logoImage}
                        alt={org.data.orgTitle}
                        width={100}
                        height={100}
                        loading="lazy"
                      />
                      {org.data.orgTitle}
                    </a>
                  </h5>
                </li>
              ))
            }
          </ul>

          {presenters.length > 0 && <h4>Presenters</h4>}
          <ul class="people">
            {
              presenters.map((person) => (
                <li>
                  <h5>
                    <a href={`/presenter/${person.data.slug}`}>
                      <EntityImage
                        kind="presenter"
                        src={person.data.imageUrl}
                        alt={person.data.presenterName}
                        width={100}
                        height={100}
                        loading="lazy"
                      />
                      {person.data.presenterName}
                    </a>
                  </h5>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
