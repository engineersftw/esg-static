---
import { type CollectionEntry, getEntries } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import EntityImage from '../../components/EntityImage.astro';
import { YouTube } from 'astro-embed';
import { getActiveVideos, listedOrganizations, listedPresenters } from '../../helpers/collections';

export async function getStaticPaths() {
  const videos = await getActiveVideos();
  return videos.map((video) => ({
    params: { slug: video.data.slug },
    props: video,
  }));
}
type Props = CollectionEntry<'video'>;

const video = Astro.props;
const organizations = listedOrganizations(await getEntries(video.data.organizations));
const presenters = listedPresenters(await getEntries(video.data.presenters));
---

<html lang="en">
  <head>
    <BaseHead
      title={video.data.videoTitle}
      description={video.body || (presenters.length > 0
        ? `A talk by ${presenters.map((presenter) => presenter.data.presenterName.trim()).join(', ')}, recorded by Engineers.SG.`
        : undefined)}
      image={video.data.thumbnailHigh ?? video.data.thumbnailMedium ?? video.data.thumbnailDefault}
      type="video.other"
    />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image lite-youtube {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        text-align: center;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }

      .videoDescr {
        white-space: pre-line;
      }

      @media (max-width: 720px) {
        .title h1 {
          font-size: 1.953em;
          line-height: 1.15;
        }
      }

      h5 a {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: rgb(var(--gray-dark));
      }
      h5 a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          <YouTube id={video.data.videoId} posterQuality="max" />
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={video.data.publishedAt} />
            </div>
            <h1>{video.data.videoTitle}</h1>
            <hr />
          </div>
          <p class="videoDescr">{video.body}</p>

          {organizations.length > 0 && <h4>Organizations</h4>}
          <ul>
            {
              organizations.map((org) => (
                <li>
                  <h5>
                    <a
                      href={`/organization/${org.data.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <EntityImage
                        kind="organization"
                        src={org.data.logoImage}
                        alt={org.data.orgTitle}
                        width={100}
                        height={100}
                        loading="lazy"
                      />
                      &nbsp;
                      {org.data.orgTitle}
                    </a>
                  </h5>
                </li>
              ))
            }
          </ul>

          {presenters.length > 0 && <h4>Presenters</h4>}
          <ul>
            {
              presenters.map((person) => (
                <li>
                  <h5>
                    <a
                      href={`/presenter/${person.data.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <EntityImage
                        kind="presenter"
                        src={person.data.imageUrl}
                        alt={person.data.presenterName}
                        width={100}
                        height={100}
                        loading="lazy"
                      />
                      &nbsp;
                      {person.data.presenterName}
                    </a>
                  </h5>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
