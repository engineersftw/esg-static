---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const REPO = 'https://github.com/engineersftw/esg-static';
const videoForm = `${REPO}/issues/new?template=submit-video.yml`;
// Playlists have no form: a prefilled issue that a maintainer follows up.
const playlistIssue = `${REPO}/issues/new?${new URLSearchParams({
  title: 'Playlist suggestion: ',
  body: [
    '**YouTube playlist URL**',
    '',
    '',
    '**Conference, meetup or group it belongs to**',
    '',
    '',
    '**Anything else we should know** (year, organizers, presenters)',
    '',
  ].join('\n'),
})}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Contribute videos"
      description="Know a Singapore tech talk that belongs on Engineers.SG? Suggest a single YouTube video or a whole playlist."
    />
    <style>
      main {
        width: 720px;
        max-width: calc(100% - 2em);
      }
      h2 {
        margin-top: 2em;
      }
      .action {
        display: inline-block;
        margin: 0.5em 0 1em;
        padding: 0.6em 1.2em;
        border-radius: 8px;
        background: var(--accent);
        color: white;
        font-weight: bold;
        text-decoration: none;
      }
      .action:hover {
        background: var(--accent-dark);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Contribute videos</h1>
      <p>
        Engineers.SG documents the Singapore tech community, and the community
        helps keep it going. If you know a talk that belongs here, whether it's
        one video or a whole conference, you can suggest it.
      </p>

      <h2>Suggest a single video</h2>
      <p>The video must be public on YouTube. You'll need a free GitHub account.</p>
      <ol>
        <li>
          Open the <a href={videoForm} target="_blank" rel="noopener noreferrer">Submit a video</a> form.
        </li>
        <li>Paste the YouTube link.</li>
        <li>
          Add the presenters, one per line. You can add their links after a{' '}
          <code>|</code>: an X handle such as <code>@janedoe</code>, or a link to
          X, LinkedIn, Instagram, TikTok or their website. Someone who already
          has a page on Engineers.SG is matched by name.
        </li>
        <li>
          Pick the meetup, conference or organization where it was given, if
          there is one. If it isn't listed, tell us under "Others (not in list)".
        </li>
      </ol>
      <a class="action" href={videoForm} target="_blank" rel="noopener noreferrer">Submit a video</a>
      <p>
        We read the title, description and thumbnail from YouTube, so you don't
        need to type them. A maintainer then reviews it, and once it's approved
        the video appears in the{' '}
        <a href="/playlist/community-contributed">Community Contributed</a>{' '}
        playlist. If something is wrong (a private video, or one that's already
        on the site), the issue gets a comment saying so, and you can edit it
        to fix it.
      </p>

      <h2>Suggest a whole playlist</h2>
      <p>
        For a conference, a meetup series or any other YouTube playlist, open an
        issue with the playlist's link and the group it belongs to. A
        maintainer adds the playlist with its videos, and links the
        presenters and organization.
      </p>
      <a class="action" href={playlistIssue} target="_blank" rel="noopener noreferrer">Suggest a playlist</a>
      <p>
        Playlists on the Engineers.SG YouTube channel are picked up
        automatically, so those don't need a suggestion.
      </p>
    </main>
    <Footer />
  </body>
</html>
