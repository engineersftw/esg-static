---
// Old Rails URLs /organizations/:id, by numeric ID or by slug.
import { getActiveOrganizations } from "../../helpers/collections";

export async function getStaticPaths() {
  const organizations = await getActiveOrganizations();
  return organizations.flatMap((organization) => [
    { params: { slug: organization.id }, props: { slug: organization.data.slug } },
    { params: { slug: organization.data.slug }, props: { slug: organization.data.slug } },
  ]);
}

return Astro.redirect(`/organization/${Astro.props.slug}`, 301);
---
