---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getActiveOrganizations } from "../../../helpers/collections";

import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Pagination from "../../../components/Pagination.astro";
import EntityImage from "../../../components/EntityImage.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const organizations = (await getActiveOrganizations()).sort((a, b) =>
    a.data.orgTitle.trim().localeCompare(b.data.orgTitle.trim())
  );
  return paginate(organizations, { pageSize: 48 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Organizations"
      description={`${page.total.toLocaleString('en')} tech communities and organizations in Singapore whose meetups and events Engineers.SG has recorded.`}
      pageNumber={page.currentPage}
    />
    <style>
      main {
        width: 960px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(30% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1;
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
      .orgImage {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
        border-radius: 12px;
        margin-bottom: 0.5rem;
        transition: 0.2s ease;
      }

      .orgImage:hover {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: calc(50% - 0.25em);
          text-align: center;
        }
        .title {
          font-size: 1em;
          line-height: 1.2;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Organizations</h1>
      <section>
        <ul>
          {
            page.data.map((organization) => (
              <li>
                <a href={`/organization/${organization.data.slug}`}>
                  <EntityImage
                    class="orgImage"
                    kind="organization"
                    src={organization.data.logoImage}
                    alt=""
                    loading="lazy"
                  />
                  <h4 class="title">{organization.data.orgTitle}</h4>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <Pagination page={page} />
    </main>
    <Footer />
  </body>
</html>
