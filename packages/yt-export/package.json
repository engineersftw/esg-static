{
  "name": "@esg/yt-export",
  "version": "1.0.0",
  "private": true,
  "description": "Export a YouTube channel's playlists and videos as episodes/playlists/playlist_items rows matching types/db.ts",
  "type": "module",
  "exports": {
    "./youtube": "./src/youtube.ts"
  },
  "scripts": {
    "export": "tsx src/export.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@esg/db-types": "workspace:*",
    "@esg/content": "workspace:*"
  }
}
