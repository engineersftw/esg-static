{
  "name": "@esg/pg-export",
  "version": "1.0.0",
  "description": "Export a Heroku Postgres database to one CSV/JSON file per table, plus schema.json",
  "type": "module",
  "bin": {
    "pg-export": "dist/export.js"
  },
  "scripts": {
    "build": "tsc",
    "export": "tsx src/export.ts",
    "start": "node dist/export.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.3"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
